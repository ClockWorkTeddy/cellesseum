@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi
<div class="container">
    <div class="row">
        <div class="col-12 d-flex justify-content-center text-secondary">
            <h1>Cellesseum</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <div class="random-number-container">
                @if (visibleNumber > 0)
                {
                    <span class="label badge-xxl me-1" style="@GetLabelStyle()">@visibleNumber</span>
                }
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 d-flex justify-content-center">
            <button class="btn btn-primary" @onclick="GetNewNumbers" disabled="@isAnimating">
                @(isAnimating ? "Loading..." : "Click me")
            </button>
        </div>
    </div>
</div>



@code {
    private int visibleNumber = -1;
    private bool isAnimating;

    private string GetLabelStyle()
    {
        // Normalize 0..100 -> 0..255
        var redRaw = (int)Math.Round((100 - visibleNumber) / 50.0 * 255);
        var red = Math.Clamp(redRaw, 0, 255);

        // Example green channel decreasing with value, also normalized
        var greenRaw = (int)Math.Round(visibleNumber / 50.0 * 255);
        var green = Math.Clamp(greenRaw, 0, 255);

        return $"--label-color:{red},{green},0";
    }

    private async Task GetNewNumbers()
    {
        if (isAnimating)
        {
            return;
        }

        isAnimating = true;

        var result = await WeatherApi.GetWeatherAsync();
        var numbers = result?.Numbers ?? Array.Empty<int>();

        foreach (var n in numbers)
        {
            visibleNumber = n;
            await InvokeAsync(StateHasChanged); // render after each addition
            await Task.Delay(25);
        }

        isAnimating = false;
    }
}
