<div>
    <canvas id="cellCanvas" class="cell-canvas"></canvas>
    <div class="stats-bar">
        <span class="stats-item">
            <span class="stats-label">Step:</span>
            <span class="saturation-badge" id="stat-step">@CurrentStep</span>
        </span>
        <span class="stats-item">
            <span class="stats-label">Plants:</span>
            <strong class="saturation-badge lbl-green" id="stat-plants">@(PlantCount ?? 0)</strong>
        </span>
        <span class="stats-item">
            <span class="stats-label">Grazers:</span>
            <strong class="saturation-badge lbl-yellow" id="stat-grazers">@(GrazerCount ?? 0)</strong>
        </span>
        <span class="stats-item">
            <span class="stats-label">Score:</span>
            <strong class="saturation-badge lbl-orange" id="stat-score">@(NormalizedScore ?? 0)</strong>
        </span>
    </div>
    <div class="divider"></div>
</div>

@code {
    [Parameter]
    public int CurrentStep { get; set; }

    [Parameter]
    public int? PlantCount { get; set; }

    [Parameter]
    public int? GrazerCount { get; set; }

    [Parameter]
    public int? NormalizedScore { get; set; }
}
