@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<main class="card">
    <div class="title">Cellesseum</div>

    <div class="value" id="value" style="@GetLabelStyle(visibleNumber, maxX: 100.0, minX: 0.0)">
        @if (visibleNumber > 0)
        {
            @visibleNumber
        }
    </div>

    <button class="btn" id="btn" type="button" @onclick="GetNewNumbers" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>

    <div class="label">Average</div>
    <div class="avg" id="avg" style="@GetLabelStyle(averageNumber, maxX: 55.0, minX: 45.0)">
        @if (averageNumber > 0 && !isAnimating)
        {
            @averageNumber
        }
    </div>
</main>

@code {
    private int visibleNumber = -1;
    private int averageNumber = -1;
    private bool isAnimating;

    private async Task GetNewNumbers()
    {
        if (isAnimating)
        {
            return;
        }

        isAnimating = true;

        var result = await WeatherApi.GetWeatherAsync();
        var numbers = result?.Numbers ?? Array.Empty<int>();
        averageNumber = result?.Average ?? -1;

        foreach (var n in numbers)
        {
            visibleNumber = n;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(25);
        }

        isAnimating = false;
    }

    private string GetLabelStyle(int value, double maxX, double minX)
    {
        var rangeY = 127;
        var rangeX = maxX - minX;

        // Normalize 0..100 -> 127..255
        var red = (int)Math.Round((maxX - value) / (rangeX / rangeY) + rangeY);
        var green = (int)Math.Round((value - minX) / (rangeX / rangeY) + rangeY);
        var blue = 127;

        return $"--dynamic-text-color:{red}, {green}, {blue}";
    }
}
