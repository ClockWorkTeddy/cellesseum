<main class="card">
    <div class="title">Cellesseum</div>
    @if (ShowLoginDisplay)
    {
        <LoginDisplay />
    }
    <canvas id="cellCanvas" class="cell-canvas"></canvas>
    <div class="stats-bar">
        <span class="stats-item">
            <span class="stats-label">Step:</span>
            <span class="stats-value" id="stat-step">@CurrentStep</span>
        </span>
        <span class="stats-item">
            <span class="stats-label">Plants:</span>
            <strong class="stats-value lbl-green" id="stat-plants">@PlantCount</strong>
        </span>
        <span class="stats-item">
            <span class="stats-label">Grazers:</span>
            <strong class="stats-value lbl-yellow" id="stat-grazers">@GrazerCount</strong>
        </span>
        <span class="stats-item">
            <span class="stats-label">Score:</span>
            <strong class="stats-value lbl-orange" id="stat-score">@NormalizedScore</strong>
        </span>
    </div>
    <div class="@(IsCompleted || IsAnimating ? "plot-section" : "plot-section plot-section-hidden")">
        <div class="divider"></div>
        <div class="plot-row">
            <div class="plot-card">
                <div class="plot-label plot-label-plants">Plants</div>
                <canvas id="plotPlants" class="plot-canvas-plants"></canvas>
            </div>
            <div class="plot-card">
                <div class="plot-label plot-label-grazers">Grazers</div>
                <canvas id="plotGrazers" class="plot-canvas-grazers"></canvas>
            </div>
        </div>
        <div class="divider"></div>
    </div>
    @if (IsAnimating)
    {
        <div class="playback-controls">
            <button class="btn" type="button" @onclick="OnPause">
                @(IsPaused ? "▶ Resume" : "⏸ Pause")
            </button>
            <button class="btn" type="button" @onclick="OnStep" disabled="@(!IsPaused)">
                ▶Step
            </button>
        </div>
    }
    <button class="btn" id="btn" type="button" @onclick="OnStart" disabled="@IsAnimating">
        @(IsAnimating ? "Running..." : "Start")
    </button>
</main>

@code {
    [Parameter]
    public bool ShowLoginDisplay { get; set; }

    [Parameter]
    public int CurrentStep { get; set; }

    [Parameter]
    public int? PlantCount { get; set; }

    [Parameter]
    public int? GrazerCount { get; set; }

    [Parameter]
    public int? NormalizedScore{ get; set; }

    [Parameter]
    public bool IsAnimating { get; set; }

    [Parameter]
    public bool IsCompleted { get; set; }

    [Parameter]
    public bool IsPaused { get; set; }

    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public EventCallback OnPause { get; set; }

    [Parameter]
    public EventCallback OnStep { get; set; }
}
