@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<main class="card">
    <div class="title">Cellesseum</div>

    <div class="cell-grid" aria-label="10x10 cells">
        @for (var i = 0; i < size*size; i++)
        {
            if (CurrentFrame?.ContainsKey(i) == true)
            {
                <div class="green-cell"></div>
                continue;
            }
            <div class="cell"></div>
        }
    </div>

    <button class="btn" id="btn" type="button" @onclick="GetData" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>

    <div class="label">Average</div>
    <div class="avg" id="avg" style="@GetLabelStyle(averageNumber, maxX: 55.0, minX: 45.0)">
        @if (averageNumber > 0 && !isAnimating)
        {
            @averageNumber
        }
    </div>
</main>

@code {
    private int visibleNumber = -1;
    private int averageNumber = -1;
    private bool isAnimating;
    private List<Dictionary<int, int>> data = new();
    private int currentFrame;
    private int size = 15;
    private Dictionary<int, int>? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    private async Task GetData()
    {
        if (isAnimating)
        {
            return;
        }

        isAnimating = true;
        data = await WeatherApi.GetWeatherAsync(this.size);
        currentFrame = 0;

        for (var i = 0; i < data.Count; i++)
        {
            currentFrame = i;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
        }

        isAnimating = false;
    }

    private string GetLabelStyle(int value, double maxX, double minX)
    {
        var rangeY = 127;
        var rangeX = maxX - minX;

        // Normalize 0..100 -> 127..255
        var red = (int)Math.Round((maxX - value) / (rangeX / rangeY) + rangeY);
        var green = (int)Math.Round((value - minX) / (rangeX / rangeY) + rangeY);
        var blue = 127;

        return $"--dynamic-text-color:{red}, {green}, {blue}";
    }
}
