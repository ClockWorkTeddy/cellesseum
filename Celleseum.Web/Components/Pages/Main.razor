<div class="main-container">
    <section class="entry-card">
        <div class="login-title">Cellesseum</div>
        <div class="login-controls">
            <div class="login-form">
                <button class="login-signin-btn" type="button" @onclick="HandlePlayAsync">Play</button>
            </div>
        </div>
    </section>

    <section class="info-card">
        <div class="info-title">What is going on?</div>
        <div class="info-divider"/>
        <p class="info-description">Cellesseum is a cellular automation game where you can observe cell evolution and behavioral patterns alongside telemetry. The game supports various modes with different rules</p>
        <div class="info-divider"/>
        <div class="info-content">
            <div class="info-text">
                <p class="info-mock-text">Plants appear and constantly growing across the field</p>
            </div>
            <div class="info-image">
                <img src="images/plants.gif" alt="Cellesseum simulation" />
            </div>
        </div>
        <div class="info-content">
            <div class="info-text">
                <p class="info-mock-text">One grazer is placed randomly at the field at the beginning of the game. It moves randomly and eats the plants</p>
            </div>
            <div class="info-image">
                <img src="images/grazing.gif" alt="Cellesseum simulation" />
            </div>
        </div>
        <div class="info-content">
            <div class="info-text">
                <p class="info-mock-text">If there is a lot of food, the grazer can divide into two new grazers, each of which will act independently</p>
            </div>
            <div class="info-image">
                <img src="images/breeding.gif" alt="Cellesseum simulation" />
            </div>
        </div>
        <div class="info-content">
            <div class="info-text">
                <p class="info-mock-text">In case of insufficient of food grazers can starve and die</p>
            </div>
            <div class="info-image">
                <img src="images/starving.gif" alt="Cellesseum simulation" />
            </div>
        </div>
    </section>
</div>

@inject NavigationManager Navigation

@code {
    [Parameter]
    public EventCallback OnPlay { get; set; }

    private async Task HandlePlayAsync()
    {
        if (OnPlay.HasDelegate)
        {
            await OnPlay.InvokeAsync();
            return;
        }

        Navigation.NavigateTo("/menu");
    }
}
