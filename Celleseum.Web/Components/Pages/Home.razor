@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Celleseum.Web.Components.Buttons
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<canvas id="demoCanvas" class="demo-bg-canvas"></canvas>
<div class="entry-stack home-entry-stack">
    @if (currentElement == HomeElement.Main)
    {
        <Main OnPlay="@(() => SelectElement(HomeElement.Menu))"/>
    }
    else if (currentElement == HomeElement.Menu)
    {
        <Menu
            OnBack="@(() => SelectElement(HomeElement.Main))"
            OnLogin="@(() => SelectElement(HomeElement.Login))" />
    }
    else if (currentElement == HomeElement.Login)
    {
        <LoginCard 
            OnBack="@(() => SelectElement(HomeElement.Menu))"
            OnRegisterClick="@(() => SelectElement(HomeElement.Registration))" />
    }
    else if (currentElement == HomeElement.Registration)
    {
        <RegisterCard OnBack="@(() => SelectElement(HomeElement.Login))" />
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "loggedOut")]
    public bool LoggedOut { get; set; }

    private IJSObjectReference? demoModule;
    private bool demoInitialized;
    private HomeElement currentElement = HomeElement.Main;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        var isLoggedOutRequest = LoggedOut || Navigation.Uri.Contains("loggedOut=true", StringComparison.OrdinalIgnoreCase);

        if (TryParseElement(Mode, out var requestedElement))
        {
            currentElement = requestedElement;
            return;
        }

        currentElement = isAuthenticated && !isLoggedOutRequest
            ? HomeElement.Menu
            : HomeElement.Main;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            demoModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/demo.js");
        }

        if (!demoInitialized && demoModule is not null)
        {
            demoInitialized = await demoModule.InvokeAsync<bool>("initDemo", "demoCanvas");
        }
    }

    private static bool TryParseElement(string? mode, out HomeElement element)
    {
        element = HomeElement.Main;

        if (string.IsNullOrWhiteSpace(mode))
        {
            return false;
        }

        if (Enum.TryParse<HomeElement>(mode, true, out var parsedElement))
        {
            element = parsedElement;
            return true;
        }

        return false;
    }

    private void SelectElement(HomeElement element)
    {
        currentElement = element;
    }

    private void LaunchPlay(string mode)
    {
        var selectedMode = string.Equals(mode, "mutation", StringComparison.OrdinalIgnoreCase)
            ? "mutation"
            : "simple";

        Navigation.NavigateTo($"/play?mode={selectedMode}&backUrl=%2F%3Fmode%3DMenu");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (demoInitialized && demoModule is not null)
            {
                await demoModule.InvokeVoidAsync("disposeDemo", "demoCanvas");
            }

            if (demoModule is not null)
            {
                await demoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private enum HomeElement
    {
        Main,
        Menu,
        Login,
        Registration
    }
}
