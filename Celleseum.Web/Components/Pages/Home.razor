@page "/"
@using MapProcessing
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@implements IAsyncDisposable

@inject MapClient MapApi
@inject IConfiguration Configuration
@inject IJSRuntime JS

<main class="card">
    <div class="title">Cellesseum</div>

    <!--<AuthorizeView>
        <Authorized>
            <div class="welcome-text">Welcome back, @context.User.Identity?.Name!</div>
        </Authorized>
    </AuthorizeView>-->

    <canvas id="cellCanvas" class="cell-canvas"></canvas>
    <div class="stats-bar">
        <span>Step: <span id="stat-step">@currentFrame</span></span>
        <span>Plants: <strong class="lbl-green" id="stat-plants">@CurrentFrame?.PlantCount</strong></span>
        <span>Grazers: <strong class="lbl-yellow" id="stat-grazers">@CurrentFrame?.GrazerCount</strong></span>
    </div>
    <button class="btn" id="btn" type="button" @onclick="GetData" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>
</main>

@code {
    private const int CellSize = 2;
    private const int Gap = 1;
    private const int LineEvery = 2;

    private IJSObjectReference? jsModule;
    private DotNetObjectReference<Home>? dotNetRef;
    private bool isAnimating;
    private List<AreaData> data = new();
    private int currentFrame;
    private int size;

    private AreaData? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    protected override void OnInitialized()
    {
        size = Configuration.GetValue("Grid:Size", 50);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cellgrid.js");
            await jsModule.InvokeVoidAsync("initCanvas", "cellCanvas", size, CellSize, Gap, LineEvery);
        }
    }

    private async Task GetData()
    {
        if (isAnimating || jsModule is null)
        {
            return;
        }

        isAnimating = true;
        data = await MapApi.GetMap(size);
        currentFrame = 0;

        var cellCount = size * size;
        var allTypes = new byte[data.Count * cellCount];
        var allSaturation = new byte[data.Count * cellCount];
        var plantCounts = new int[data.Count];
        var grazerCounts = new int[data.Count];

        for (var i = 0; i < data.Count; i++)
        {
            var frame = data[i];
            plantCounts[i] = frame.PlantCount;
            grazerCounts[i] = frame.GrazerCount;
            var offset = i * cellCount;
            Buffer.BlockCopy(frame.Types, 0, allTypes, offset, cellCount);
            Buffer.BlockCopy(frame.Saturations, 0, allSaturation, offset, cellCount);
        }

        dotNetRef ??= DotNetObjectReference.Create(this);
        await jsModule.InvokeVoidAsync("playAllFrames",
            "cellCanvas", allTypes, allSaturation,
            plantCounts, grazerCounts, 25, dotNetRef);
    }

    [JSInvokable]
    public void OnAnimationComplete()
    {
        isAnimating = false;
        currentFrame = data.Count - 1;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        if (jsModule is not null)
        {
            await jsModule.InvokeVoidAsync("dispose", "cellCanvas");
            await jsModule.DisposeAsync();
        }
    }
}
