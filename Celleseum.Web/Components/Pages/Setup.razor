@page "/setup"
@using Celleseum.Web.Components.Buttons
@rendermode InteractiveServer

<div class="entry-stack home-entry-stack">
    <main class="entry-card menu-card">
        <div class="menu-header">
            <div class="menu-back-slot">
                <BackButton OnBack="HandleBack" />
            </div>
            <div class="login-title menu-title">Game setup</div>
            <div></div>
        </div>

        <div class="login-controls menu-controls">
            <div class="login-form menu-form setup-form">

                @* Field size *@
                <div class="setup-field-group">
                    <div class="setup-field-row">
                        <span class="setup-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="3" width="7" height="7" rx="1" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
                                <rect x="14" y="3" width="7" height="7" rx="1" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
                                <rect x="3" y="14" width="7" height="7" rx="1" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
                                <rect x="14" y="14" width="7" height="7" rx="1" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
                            </svg>
                        </span>
                        <div class="setup-input-wrap">
                            <input id="sizeInput" type="number" class="setup-input" placeholder="Field size" autocomplete="off"
                                   value="@size" @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var v)) size = v; }" />
                        </div>
                    </div>
                    <div class="setup-hint-row">
                        <span class="setup-hint">Max: @MaxSize.ToString("N0")</span>
                    </div>
                </div>

                @* Steps quantity *@
                <div class="setup-field-group">
                    <div class="setup-field-row">
                        <span class="setup-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="rgba(255,255,255,0.75)" class="size-6">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
                            </svg>
                        </span>
                        <div class="setup-input-wrap">
                            <input id="termsInput" type="number" class="setup-input" placeholder="Steps quantity" autocomplete="off"
                                   value="@terms" @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var v)) terms = v; }" />
                        </div>
                    </div>
                    <div class="setup-hint-row">
                        <span class="setup-hint">Max: @MaxTerms.ToString("N0")</span>
                    </div>
                </div>

                @* Cell size *@
                <div class="setup-field-group">
                    <div class="setup-field-row">
                        <span class="setup-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="rgba(255,255,255,0.75)" class="size-6">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                            </svg>
                        </span>
                        <div class="setup-input-wrap">
                            <input id="cellSizeInput" type="number" class="setup-input" placeholder="Cell size" autocomplete="off"
                                   value="@cellSize" @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var v)) cellSize = v; }" />
                        </div>
                    </div>
                    <div class="setup-hint-row">
                        <span class="setup-hint">Max: @MaxCellSize.ToString("N0")</span>
                    </div>
                </div>

                @* Step delay *@
                <div class="setup-field-group">
                    <div class="setup-field-row">
                        <span class="setup-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="9" stroke="rgba(255,255,255,0.75)" stroke-width="1.5"/>
                                <polyline points="12,7 12,12 15.5,15.5" stroke="rgba(255,255,255,0.75)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <div class="setup-input-wrap">
                            <input id="animationDelayInput" type="number" class="setup-input" placeholder="Step delay" autocomplete="off"
                                   value="@animationDelayMilliseconds" @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var v)) animationDelayMilliseconds = v; }" />
                        </div>
                    </div>
                    <div class="setup-hint-row">
                        <span class="setup-hint">Min: @MinAnimationDelayMilliseconds ms</span>
                    </div>
                </div>

                @* Use gridlines *@
                <div class="setup-field-group">
                    <div class="setup-field-row setup-checkbox-row">
                        <span class="setup-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <line x1="9" y1="4" x2="9" y2="20" stroke="rgba(255,255,255,0.75)" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="15" y1="4" x2="15" y2="20" stroke="rgba(255,255,255,0.75)" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="4" y1="9" x2="20" y2="9" stroke="rgba(255,255,255,0.75)" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="4" y1="15" x2="20" y2="15" stroke="rgba(255,255,255,0.75)" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <InputCheckbox id="gapInput" class="setup-checkbox" @bind-Value="gapEnabled" />
                        <label class="setup-checkbox-label" for="gapInput">Use gridlines (1px/0px)</label>
                    </div>
                </div>

                @* Constraints *@
                <div class="setup-constraints">
                    <span class="@(IsComplexityViolated ? "setup-constraint-error" : "")">FieldSize * FieldSize * StepsQuantity &lt;= 1,000,000,000</span>
                    <span class="@(IsCanvasViolated ? "setup-constraint-error" : "")">FieldSize * (CellSize + GridLine) &lt;= 1,000</span>
                </div>

                <button class="login-signin-btn" type="button" @onclick="LaunchPlay" disabled="@(!CanStart)">Start</button>
            </div>
        </div>
    </main>
</div>

@inject NavigationManager Navigation

@code {
    private const int DefaultSize = 200;
    private const int DefaultTerms = 100;
    private const int DefaultCellSize = 2;
    private const int DefaultAnimationDelayMilliseconds = 25;
    private const int MinAnimationDelayMilliseconds = 15;
    private const long MaxComplexity = 1_000_000_000;
    private const int MaxCanvasPixels = 1_000;

    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "backUrl")]
    public string? BackUrl { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    public int? Size { get; set; }

    [SupplyParameterFromQuery(Name = "terms")]
    public int? Terms { get; set; }

    [SupplyParameterFromQuery(Name = "cellSize")]
    public int? CellSize { get; set; }

    [SupplyParameterFromQuery(Name = "gap")]
    public int? Gap { get; set; }

    [SupplyParameterFromQuery(Name = "animationDelayMs")]
    public int? AnimationDelayMs { get; set; }

    private int size = DefaultSize;
    private int terms = DefaultTerms;
    private int cellSize = DefaultCellSize;
    private int animationDelayMilliseconds = DefaultAnimationDelayMilliseconds;
    private bool gapEnabled = true;

    private int GapSize => gapEnabled ? 1 : 0;

    private int MaxTerms
    {
        get
        {
            if (size <= 0)
            {
                return 0;
            }

            var sizeSquared = (long)size * size;
            return sizeSquared == 0 ? 0 : (int)(MaxComplexity / sizeSquared);
        }
    }

    private int MaxSizeByTerms
    {
        get
        {
            if (terms <= 0)
            {
                return 0;
            }

            var maxSize = Math.Sqrt(MaxComplexity / (double)terms);
            return (int)Math.Floor(maxSize);
        }
    }

    private int MaxSizeByCanvas
    {
        get
        {
            var step = cellSize + GapSize;
            return step <= 0 ? 0 : MaxCanvasPixels / step;
        }
    }

    private int MaxSize => Math.Min(MaxSizeByTerms, MaxSizeByCanvas);

    private int MaxCellSize
    {
        get
        {
            if (size <= 0)
            {
                return 0;
            }

            var maxCellSize = (MaxCanvasPixels / size) - GapSize;
            return Math.Max(0, maxCellSize);
        }
    }

    private bool CanStart => Validate(out _);

    private bool IsComplexityViolated => (long)size * size * terms > MaxComplexity;
    private bool IsCanvasViolated => size * (cellSize + GapSize) > MaxCanvasPixels;

    private string? CurrentValidationError
    {
        get
        {
            Validate(out var error);
            return error;
        }
    }

    protected override void OnParametersSet()
    {
        size = NormalizePositive(Size, DefaultSize);
        terms = NormalizePositive(Terms, DefaultTerms);
        cellSize = NormalizePositive(CellSize, DefaultCellSize);
        animationDelayMilliseconds = NormalizePositive(AnimationDelayMs, DefaultAnimationDelayMilliseconds);
        gapEnabled = Gap.GetValueOrDefault(1) != 0;
    }

    private void HandleBack()
    {
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(BackUrl) ? "/?mode=Menu" : BackUrl!);
    }

    private void LaunchPlay()
    {
        if (!Validate(out _))
        {
            return;
        }

        var selectedMode = string.Equals(Mode, "mutation", StringComparison.OrdinalIgnoreCase)
            ? "mutation"
            : "simple";

        var menuBackUrl = string.IsNullOrWhiteSpace(BackUrl) ? "/?mode=Menu" : BackUrl!;
        var returnToSetup = $"/setup?mode={selectedMode}&backUrl={Uri.EscapeDataString(menuBackUrl)}&size={size}&terms={terms}&cellSize={cellSize}&gap={GapSize}&animationDelayMs={animationDelayMilliseconds}";

        Navigation.NavigateTo($"/play?mode={selectedMode}&size={size}&terms={terms}&cellSize={cellSize}&gap={GapSize}&animationDelayMs={animationDelayMilliseconds}&backUrl={Uri.EscapeDataString(returnToSetup)}");
    }

    private bool Validate(out string? error)
    {
        if (size <= 0)
        {
            error = "Size must be greater than 0.";
            return false;
        }

        if (terms <= 0)
        {
            error = "Terms must be greater than 0.";
            return false;
        }

        if (cellSize <= 0)
        {
            error = "Cell size must be greater than 0.";
            return false;
        }

        if (animationDelayMilliseconds < MinAnimationDelayMilliseconds)
        {
            error = $"Animation delay must be at least {MinAnimationDelayMilliseconds} ms.";
            return false;
        }

        if (IsComplexityViolated)
        {
            error = "size × size × terms must be less than or equal to 1,000,000,000.";
            return false;
        }

        if (IsCanvasViolated)
        {
            error = "size × (cell size + gap) must be less than or equal to 1,000.";
            return false;
        }

        error = null;
        return true;
    }

    private static int NormalizePositive(int? value, int fallback)
    {
        return value is > 0 ? value.Value : fallback;
    }
}
