@page "/"
@using MapProcessing
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@implements IAsyncDisposable

@inject MapClient MapApi
@inject IConfiguration Configuration
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>
        <main class="card">
            <div class="title">Cellesseum</div>
            <LoginDisplay />
            <canvas id="cellCanvas" class="cell-canvas"></canvas>
            <div class="stats-bar">
                <span>Step: <span id="stat-step">@currentFrame</span></span>
                <span>Plants: <strong class="lbl-green" id="stat-plants">@CurrentFrame?.PlantCount</strong></span>
                <span>Grazers: <strong class="lbl-yellow" id="stat-grazers">@CurrentFrame?.GrazerCount</strong></span>
            </div>
            <button class="btn" id="btn" type="button" @onclick="GetData" disabled="@isAnimating">
                @(isAnimating ? "Loading..." : "Start")
            </button>
            <div class="divider"></div>
        </main>
    </Authorized>
    <NotAuthorized>
        <main class="card card-guest">
            <canvas id="demoCanvas" class="card-guest-canvas"></canvas>
            <div class="card-guest-content">
                <div class="title">Cellesseum</div>
                <div class="card-guest-spacer"></div>
                <LoginDisplay />
            </div>
        </main>
    </NotAuthorized>
</AuthorizeView>
@code {
    private const int CellSize = 2;
    private const int Gap = 1;
    private const int LineEvery = 1;
    private const int AnimationDelayMilliseconds = 20;
    private const int InitialBufferSize = 100;
    private const int BatchSize = 150;

    private IJSObjectReference? jsModule;
    private IJSObjectReference? demoModule;
    private bool demoInitialized;
    private DotNetObjectReference<Home>? dotNetRef;
    private TaskCompletionSource<bool>? playbackCompletion;
    private bool isAnimating;
    private readonly List<AreaData> data = new();
    private int currentFrame;
    private int nextFrameStart;
    private int size;

    private AreaData? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    protected override void OnInitialized()
    {
        size = Configuration.GetValue("Grid:Size", 50);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cellgrid.js");
            demoModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/demo.js");

            await jsModule.InvokeVoidAsync("initCanvas", "cellCanvas", size, CellSize, Gap, LineEvery);
        }

        if (!demoInitialized && demoModule is not null)
        {
            demoInitialized = await demoModule.InvokeAsync<bool>("initDemo", "demoCanvas");
        }
    }

    private async Task GetData()
    {
        if (isAnimating || jsModule is null)
        {
            return;
        }

        isAnimating = true;
        data.Clear();
        currentFrame = 0;
        nextFrameStart = 0;
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var stream = MapApi.GetMapStream(size).GetAsyncEnumerator();

            var startupBatch = await ReadBatchAsync(stream, InitialBufferSize);
            if (startupBatch.Count == 0)
            {
                isAnimating = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            playbackCompletion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            dotNetRef ??= DotNetObjectReference.Create(this);

            await jsModule.InvokeVoidAsync("startPlayback", "cellCanvas", AnimationDelayMilliseconds, dotNetRef);
            await QueueBatchAsync(startupBatch);

            while (true)
            {
                var nextBatch = await ReadBatchAsync(stream, BatchSize);
                if (nextBatch.Count == 0)
                {
                    break;
                }

                await QueueBatchAsync(nextBatch);
            }

            await jsModule.InvokeVoidAsync("completePlayback", "cellCanvas");
            await playbackCompletion.Task;
        }
        finally
        {
            isAnimating = false;
            currentFrame = Math.Max(data.Count - 1, 0);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<List<AreaData>> ReadBatchAsync(IAsyncEnumerator<AreaData> stream, int maxCount)
    {
        var batch = new List<AreaData>(maxCount);
        while (batch.Count < maxCount && await stream.MoveNextAsync())
        {
            var frame = stream.Current;
            data.Add(frame);
            batch.Add(frame);
        }

        return batch;
    }

    private async Task QueueBatchAsync(List<AreaData> batch)
    {
        if (jsModule is null || batch.Count == 0)
        {
            return;
        }

        var startFrame = nextFrameStart;
        var cellCount = size * size;
        var allTypes = new byte[batch.Count * cellCount];
        var allSaturation = new byte[batch.Count * cellCount];
        var plantCounts = new int[batch.Count];
        var grazerCounts = new int[batch.Count];

        for (var i = 0; i < batch.Count; i++)
        {
            var frame = batch[i];
            plantCounts[i] = frame.PlantCount;
            grazerCounts[i] = frame.GrazerCount;
            var offset = i * cellCount;
            Buffer.BlockCopy(frame.Types, 0, allTypes, offset, cellCount);
            Buffer.BlockCopy(frame.Saturations, 0, allSaturation, offset, cellCount);
        }

        nextFrameStart += batch.Count;
        currentFrame = nextFrameStart - 1;

        await jsModule.InvokeVoidAsync("enqueueFrames",
            "cellCanvas", allTypes, allSaturation,
            plantCounts, grazerCounts, startFrame);
    }

    [JSInvokable]
    public void OnPlaybackComplete()
    {
        playbackCompletion?.TrySetResult(true);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        try
        {
            if (jsModule is not null)
            {
                await jsModule.InvokeVoidAsync("dispose", "cellCanvas");
                await jsModule.DisposeAsync();
            }
            if (demoModule is not null)
            {
                await demoModule.InvokeVoidAsync("disposeDemo", "demoCanvas");
                await demoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Browser navigated away, circuit is gone — JS cleanup is not needed
        }
    }
}
