@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<main class="card">
    <div class="title">Cellesseum</div>

    <div class="cell-grid" aria-label="10x10 cells">
        @for (var i = 0; i < size*size; i++)
        {
            if (CurrentFrame?.ContainsKey(i) == true)
            {
                if (CurrentFrame?[i] == 1)
                {
                    <div class="green-cell"></div>
                    continue;

                }
                if (CurrentFrame?[i] == 2)
                {
                    <div class="yellow-cell"></div>
                    continue;
                }
            }
            <div class="cell"></div>
        }
    </div>

    <button class="btn" id="btn" type="button" @onclick="GetData" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>
</main>

@code {
    private int visibleNumber = -1;
    private int averageNumber = -1;
    private bool isAnimating;
    private List<Dictionary<int, int>> data = new();
    private int currentFrame;
    private int size = 75;
    private Dictionary<int, int>? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    private async Task GetData()
    {
        if (isAnimating)
        {
            return;
        }

        isAnimating = true;
        data = await WeatherApi.GetWeatherAsync(this.size);
        currentFrame = 0;

        for (var i = 0; i < data.Count; i++)
        {
            currentFrame = i;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);
        }

        isAnimating = false;
    }
}
