@page "/"
@using Celleseum.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject CellesseumDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<Main
    OnPlay="LaunchPlay"
    RecentResults="recentResults" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "loggedOut")]
    public bool LoggedOut { get; set; }

    private IJSObjectReference? demoModule;
    private bool demoInitialized;
    private bool shouldNavigateToMenu;
    private List<Result> recentResults = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        var isLoggedOutRequest = LoggedOut || Navigation.Uri.Contains("loggedOut=true", StringComparison.OrdinalIgnoreCase);

        shouldNavigateToMenu = isAuthenticated && !isLoggedOutRequest;

        if (!shouldNavigateToMenu)
        {
            await LoadRecentResultsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shouldNavigateToMenu)
        {
            Navigation.NavigateTo("/menu", replace: true);
            return;
        }

        if (firstRender)
        {
            demoModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/demo.js");
        }

        if (!shouldNavigateToMenu && !demoInitialized && demoModule is not null)
        {
            demoInitialized = await demoModule.InvokeAsync<bool>("initDemo", "demoCanvas");
        }
    }

    private void LaunchPlay()
    {
        var mode = string.Equals(Mode, "mutation", StringComparison.OrdinalIgnoreCase)
            ? "mutation"
            : "simple";

        Navigation.NavigateTo($"/play?mode={mode}&backUrl=%2F");
    }

    private async Task LoadRecentResultsAsync()
    {
        recentResults = await DbContext.Results
            .OrderByDescending(r => r.DateTime)
            .Take(5)
            .ToListAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (demoInitialized && demoModule is not null)
            {
                await demoModule.InvokeVoidAsync("disposeDemo", "demoCanvas");
            }

            if (demoModule is not null)
            {
                await demoModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
