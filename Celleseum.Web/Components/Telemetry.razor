@using Celleseum.Web.Components.Enums
@using System.Linq

<div class="@(IsCompleted || IsAnimating ? "plot-section" : "plot-section plot-section-hidden")">
    <div class="plot-row">
        <div class="plot-card">
            <strong class="saturation-badge lbl-green" id="stat-plants">Plants</strong>
            <PlotChart
                CanvasId="plotPlants"
                CanvasClass="plot-canvas plot-canvas-plants"
                Label="Plants"
                PlotBatch="@PlantPlotBatch"
                PlotBatchVersion="@PlotBatchVersion"
                PlotResetVersion="@PlotResetVersion"
                HorizontalGridGap="5000"
                VerticalGridGap="250"
                Terms="@Terms" />
        </div>
        <div class="plot-card">
            @if (GameMode == GameMode.Simple)
            {
                <strong class="saturation-badge lbl-yellow" id="stat-plants">Grazers</strong>
                <PlotChart
                    CanvasId="plotGrazers"
                    CanvasClass="plot-canvas plot-canvas-grazers"
                    Label="Grazers"
                    PlotBatch="@GrazerPlotBatch"
                    PlotBatchVersion="@PlotBatchVersion"
                    PlotResetVersion="@PlotResetVersion"
                    HorizontalGridGap="250"
                    VerticalGridGap="500"
                    Terms="@Terms" />
            }
            else
            {
                <div class="saturation-badges saturation-badges-plot" style="--saturation-count:@Math.Max(1, GrazerSaturationLevelCount);">
                    @for (var saturation = 0; saturation < GrazerSaturationLevelCount; saturation++)
                    {
                        <strong class="saturation-badge saturation-badge-@saturation"
                                id="@($"stat-grazer-{saturation}")"
                                title="@($"Saturation {saturation}")"
                                style="@GetSaturationColorStyle(saturation)">@GetGrazerCountBySaturation(saturation)</strong>
                    }
                </div>
                <PlotChart
                    CanvasId="plotGrazers"
                    CanvasClass="plot-canvas plot-canvas-grazers"
                    CanvasStyle="@MutationGrazerPlotStyle"
                    Label="Grazers"
                    PlotBatch="@GrazerPlotBatch"
                    PlotBatchVersion="@PlotBatchVersion"
                    PlotResetVersion="@PlotResetVersion"
                    WindowSize="@GrazerPlotWindowSize"
                    HorizontalGridGap="100"
                    VerticalGridGap="25"
                    Terms="@Terms" />
            }
        </div>
    </div>
    <div class="divider"></div>
</div>

@code {
    [Parameter]
    public bool IsAnimating { get; set; }

    [Parameter]
    public bool IsCompleted { get; set; }

    [Parameter]
    public GameMode GameMode { get; set; }

    [Parameter]
    public int[][]? PlotBatch { get; set; }

    [Parameter]
    public long PlotBatchVersion { get; set; }

    [Parameter]
    public long PlotResetVersion { get; set; }

    [Parameter]
    public int? GrazerPlotWindowSize { get; set; }

    [Parameter]
    public int[]? GrazerCountsBySaturation { get; set; }

    [Parameter]
    public int GrazerSaturationLevelCount { get; set; }

    [Parameter]
    public int Terms { get; set; } = 3000;

    private int[][]? PlantPlotBatch =>
        PlotBatch is { Length: > 0 }
            ? new[] { PlotBatch[0] }
            : null;

    private int[][]? GrazerPlotBatch
    {
        get
        {
            if (PlotBatch is not { Length: > 1 })
            {
                return null;
            }

            var grazerRows = new int[PlotBatch.Length - 1][];
            Array.Copy(PlotBatch, 1, grazerRows, 0, PlotBatch.Length - 1);
            return grazerRows;
        }
    }

    private int GetGrazerCountBySaturation(int saturation)
    {
        if (GrazerCountsBySaturation is null || (uint)saturation >= (uint)GrazerCountsBySaturation.Length)
        {
            return 0;
        }

        return GrazerCountsBySaturation[saturation];
    }

    private string MutationGrazerPlotStyle
    {
        get
        {
            if (GameMode != GameMode.Mutation || GrazerSaturationLevelCount <= 0)
            {
                return string.Empty;
            }

            var primary = GetSaturationColorCss(0);
            var secondary = string.Join("|", Enumerable.Range(1, Math.Max(0, GrazerSaturationLevelCount - 1)).Select(GetSaturationColorCss));
            return $"--plot-series-color: {primary}; --plot-series-colors: {secondary}; --plot-primary-fill-alpha: 0; --plot-primary-line-width: 1; --plot-secondary-line-width: 1;";
        }
    }

    private string GetSaturationColorStyle(int saturation)
    {
        if (GameMode != GameMode.Mutation || GrazerSaturationLevelCount <= 0)
        {
            return string.Empty;
        }

        return $"color: {GetSaturationColorCss(saturation)};";
    }

    private string GetSaturationColorCss(int saturation)
    {
        var sectionCount = GrazerSaturationLevelCount + 1d;
        var hue = 120d - (360d / sectionCount) * (saturation + 1d);
        while (hue < 0d)
        {
            hue += 360d;
        }

        var h = hue % 360d;
        var x = 1d - Math.Abs((h / 60d % 2d) - 1d);

        var (r1, g1, b1) = h switch
        {
            < 60d => (1d, x, 0d),
            < 120d => (x, 1d, 0d),
            < 180d => (0d, 1d, x),
            < 240d => (0d, x, 1d),
            < 300d => (x, 0d, 1d),
            _ => (1d, 0d, x)
        };

        var r = (int)Math.Round(r1 * 255d);
        var g = (int)Math.Round(g1 * 255d);
        var b = (int)Math.Round(b1 * 255d);

        return $"rgb({r}, {g}, {b})";
    }
}
