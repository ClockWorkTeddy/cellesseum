@page "/"
@using MapProcessing
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]
@implements IAsyncDisposable

@inject MapClient MapApi
@inject IConfiguration Configuration
@inject IJSRuntime JS

<main class="card">
    <div class="title">Cellesseum</div>

    <!--<AuthorizeView>
        <Authorized>
            <div class="welcome-text">Welcome back, @context.User.Identity?.Name!</div>
        </Authorized>
    </AuthorizeView>-->

    <canvas id="cellCanvas" class="cell-canvas"></canvas>
    <div class="stats-bar">
        <span>Step: @currentFrame</span>
        <span>Plants: <strong class="lbl-green">@CurrentFrame?.PlantCount</strong></span>
        <span>Grazers: <strong class="lbl-yellow">@CurrentFrame?.GrazerCount</strong></span>
    </div>
    <button class="btn" id="btn" type="button" @onclick="GetData" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>
</main>

@code {
    private const int CellSize = 5;
    private const int Gap = 1;
    private const int LineEvery = 2;

    private IJSObjectReference? jsModule;
    private bool isAnimating;
    private List<AreaData> data = new();
    private int currentFrame;
    private int size;

    private AreaData? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    protected override void OnInitialized()
    {
        size = Configuration.GetValue("Grid:Size", 50);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cellgrid.js");
            await jsModule.InvokeVoidAsync("initCanvas", "cellCanvas", size, CellSize, Gap, LineEvery);
        }
    }

    private async Task GetData()
    {
        if (isAnimating || jsModule is null)
        {
            return;
        }

        isAnimating = true;
        data = await MapApi.GetMap(size);
        currentFrame = 0;

        for (var i = 0; i < data.Count; i++)
        {
            currentFrame = i;
            var bytes = FrameToBytes(data[i]);
            await jsModule.InvokeVoidAsync("drawFrame", "cellCanvas", bytes);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(25);
        }

        isAnimating = false;
    }

    private byte[] FrameToBytes(AreaData frame)
    {
        var bytes = new byte[size * size];
        foreach (var (index, value) in frame.CurrentArea)
        {
            if ((uint)index < (uint)bytes.Length)
                bytes[index] = (byte)value;
        }
        return bytes;
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            await jsModule.InvokeVoidAsync("dispose", "cellCanvas");
            await jsModule.DisposeAsync();
        }
    }
}
