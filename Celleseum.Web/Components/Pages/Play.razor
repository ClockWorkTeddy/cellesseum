<main class="card">
    <div class="title">Cellesseum</div>
    @if (ShowLoginDisplay)
    {
        <LoginDisplay />
    }
    <canvas id="cellCanvas" class="cell-canvas"></canvas>
    <div class="stats-bar">
        <span>Step: <span id="stat-step">@CurrentStep</span></span>
        <span>Plants: <strong class="lbl-green" id="stat-plants">@PlantCount</strong></span>
        <span>Grazers: <strong class="lbl-yellow" id="stat-grazers">@GrazerCount</strong></span>
        <span>Score: <strong class="lbl-orange" id="stat-score">@Score</strong></span>
    </div>
    <button class="btn" id="btn" type="button" @onclick="OnStart" disabled="@IsAnimating">
        @(IsAnimating ? "Loading..." : "Start")
    </button>
    <div class="divider"></div>
</main>

@code {
    [Parameter]
    public bool ShowLoginDisplay { get; set; }

    [Parameter]
    public int CurrentStep { get; set; }

    [Parameter]
    public int? PlantCount { get; set; }

    [Parameter]
    public int? GrazerCount { get; set; }

    [Parameter]
    public int? Score { get; set; }

    [Parameter]
    public bool IsAnimating { get; set; }

    [Parameter]
    public EventCallback OnStart { get; set; }
}
