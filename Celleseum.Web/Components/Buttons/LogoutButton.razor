@using Celleseum.Web.Components.Enums

<button type="button" class="@ButtonClass" @onclick="OnClick" aria-label="Sign out">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
    </svg>
</button>

@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public IconButtonSize Size { get; set; } = IconButtonSize.Small;

    [Parameter]
    public string? Class { get; set; }

    private string ButtonClass
    {
        get
        {
            var sizeClass = Size switch
            {
                IconButtonSize.Small => "service-button-small",
                IconButtonSize.Large => "service-button-large",
                _ => "service-button-medium"
            };

            return string.IsNullOrWhiteSpace(Class)
                ? $"service-button {sizeClass}"
                : $"service-button {sizeClass} {Class}";
        }
    }
}
