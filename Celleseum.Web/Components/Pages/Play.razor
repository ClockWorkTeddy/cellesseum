@page "/play"
@using Celleseum.Data
@using Celleseum.Web.Components.Buttons
@using MapProcessing
@using Celleseum.Web.Components.Enums
@using System.Security.Claims
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@implements IAsyncDisposable
@inject NavigationManager Navigation

@inject MapClient MapApi
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject CellesseumDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Play> Logger
<div class="entry-stack  home-entry-stack">
    <main class="card">
        <div class="row">
            <div class="col-2 d-flex justify-content-start align-items-center">
                <BackButton Size="IconButtonSize.Medium" OnBack="@HandleBackAsync" />
            </div>
            <div class="col-8">
                <div class="login-title">Cellesseum</div>
            </div>
            <div class="col-2"></div>
        </div>
        <GameField
          CurrentStep="@currentFrame"
          PlantCount="@CurrentFrame?.PlantCount"
          GrazerCount="@CurrentFrame?.GrazerCount"
          NormalizedScore="@CurrentFrame?.NormalizedScore" />
        @if (isLoading)
        {
            <div class="sim-loading-overlay">
                <div class="sim-loading-label">Simulating…</div>
                <div class="sim-progress-track">
                    <div class="sim-progress-fill" style="width:@(loadedFrames * 100 / Math.Max(1, plotTerms))%"></div>
                </div>
                <div class="sim-loading-counter">@loadedFrames / @plotTerms frames</div>
            </div>
        }
        <PlaybackControls
          IsAnimating="@isAnimating"
          IsPaused="@isPaused"
          OnStart="GetData"
          OnTogglePause="TogglePause"
          OnStepPlayback="StepPlayback" />
        <Telemetry
          IsAnimating="@isAnimating"
          IsCompleted="@isCompleted"
          GameMode="@CurrentGameMode"
          PlotBatch="@plotBatch"
          PlotBatchVersion="@plotBatchVersion"
          PlotResetVersion="@plotResetVersion"
          GrazerPlotWindowSize="@grazerPlotWindowSize"
          GrazerCountsBySaturation="@CurrentFrame?.GrazerCountsBySaturation"
          Terms="@plotTerms" />
    </main>
</div>


@code {
    private const int CellSize = 1;
    private const int Gap = 0;
    private const int LineEvery = 1;
    private const int AnimationDelayMilliseconds = 40;
    private const int InitialBufferSize = 50;
    private const int BatchSize = 150;
    private const int GrazerSaturationLevelCount = 8;

    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [SupplyParameterFromQuery(Name = "backUrl")]
    public string? BackUrl { get; set; }

    private IJSObjectReference? jsModule;
    private bool gridInitialized;
    private DotNetObjectReference<Play>? dotNetRef;
    private TaskCompletionSource<bool>? playbackCompletion;
    private bool isAuthenticated;
    private bool isLoading;
    private int loadedFrames;
    private bool isAnimating;
    private bool isPaused;
    private bool isCompleted;
    private readonly List<AreaData> data = new();
    private int currentFrame;
    private int nextFrameStart;
    private int gridWidth;
    private int gridHeight;
    private int[][]? plotBatch;
    private long plotBatchVersion;
    private long plotResetVersion;
    private int plotTerms;
    private int? grazerPlotWindowSize;
    private readonly List<int> plantPlotHistory = new();
    private readonly List<int> grazerPlotHistory = new();
    private readonly List<int>[] grazerSaturationPlotHistory = CreatePlotHistorySeries(GrazerSaturationLevelCount);

    private GameMode CurrentGameMode =>
        string.Equals(Mode, "mutation", StringComparison.OrdinalIgnoreCase)
            ? GameMode.Mutation
            : GameMode.Simple;

    private static List<int>[] CreatePlotHistorySeries(int count)
    {
        var series = new List<int>[count];
        for (var i = 0; i < count; i++)
        {
            series[i] = new List<int>();
        }

        return series;
    }

    private AreaData? CurrentFrame =>
        data.Count > 0 && currentFrame >= 0 && currentFrame < data.Count
            ? data[currentFrame]
            : null;

    private async Task HandleBackAsync()
    {
        if (!string.IsNullOrWhiteSpace(BackUrl))
        {
            Navigation.NavigateTo(BackUrl);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        gridWidth = Configuration.GetValue("Grid:Width", 50);
        gridHeight = Configuration.GetValue("Grid:Height", 50);
        plotTerms = Configuration.GetValue("Plot:Terms", 3000);

        var legacyPlotWindowSize = Configuration.GetValue<int?>("Plot:WindowSize");
        grazerPlotWindowSize = Configuration.GetValue<int?>("Plot:GrazersWindowSize") ?? legacyPlotWindowSize;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cellgrid.js");
        }

        if (!gridInitialized && jsModule is not null)
        {
            gridInitialized = await jsModule.InvokeAsync<bool>("initCanvas", "cellCanvas", gridWidth, gridHeight, CellSize, Gap, LineEvery);
        }
    }

    private async Task GetData()
    {
        if (isAnimating || jsModule is null || !gridInitialized)
        {
            return;
        }

        isAnimating = true;
        isLoading = true;
        loadedFrames = 0;
        isCompleted = false;

        data.Clear();
        currentFrame = 0;
        nextFrameStart = 0;
        plantPlotHistory.Clear();
        grazerPlotHistory.Clear();
        for (var saturation = 0; saturation < GrazerSaturationLevelCount; saturation++)
        {
            grazerSaturationPlotHistory[saturation].Clear();
        }

        plotBatch = Array.Empty<int[]>();
        plotResetVersion++;
        await InvokeAsync(StateHasChanged);

        try
        {
            var simulationMode = string.Equals(Mode, "mutation", StringComparison.OrdinalIgnoreCase)
                ? "mutation"
                : "simple";

            // Phase 1: stream all frames from the server as they are computed,
            // updating the progress overlay every 50 frames so the user sees activity immediately.
            await foreach (var frame in MapApi.GetMapStream(gridWidth, gridHeight, simulationMode, plotTerms))
            {
                data.Add(frame);
                loadedFrames = data.Count;
                if (loadedFrames % 50 == 0)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }

            if (data.Count == 0)
            {
                isAnimating = false;
                isLoading = false;
                isCompleted = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            isLoading = false;
            await InvokeAsync(StateHasChanged);

            // Phase 2: all frames are in memory — queue them to JS in batches and play.
            // Because the server wait is over, batches are sent at memory speed so the
            // JS queue never drains mid-animation.
            playbackCompletion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            dotNetRef ??= DotNetObjectReference.Create(this);

            await jsModule.InvokeVoidAsync("startPlayback", "cellCanvas", AnimationDelayMilliseconds, dotNetRef);

            for (var i = 0; i < data.Count; i += BatchSize)
            {
                var batch = data.GetRange(i, Math.Min(BatchSize, data.Count - i));
                await QueueBatchAsync(batch);
            }

            await SaveResultAsync();

            await jsModule.InvokeVoidAsync("completePlayback", "cellCanvas");
            await playbackCompletion.Task;
        }
        finally
        {
            isLoading = false;
            isAnimating = false;
            isCompleted = data.Count > 0;
            currentFrame = Math.Max(data.Count - 1, 0);
            await InvokeAsync(StateHasChanged);
        }
    }

        private async Task TogglePause()
    {
        if (jsModule is null) return;

        if (isPaused)
        {
            await jsModule.InvokeVoidAsync("resumePlayback", "cellCanvas");
        }
        else
        {
            await jsModule.InvokeVoidAsync("pausePlayback", "cellCanvas");
        }

        isPaused = !isPaused;
    }

    private async Task StepPlayback()
    {
        if (jsModule is null || !isPaused) return;
        await jsModule.InvokeVoidAsync("stepPlayback", "cellCanvas");
    }

    private async Task<List<AreaData>> ReadBatchAsync(IAsyncEnumerator<AreaData> stream, int maxCount)
    {
        var batch = new List<AreaData>(maxCount);
        while (batch.Count < maxCount && await stream.MoveNextAsync())
        {
            var frame = stream.Current;
            data.Add(frame);
            batch.Add(frame);
        }

        return batch;
    }

    private async Task QueueBatchAsync(List<AreaData> batch)
    {
        if (jsModule is null || batch.Count == 0)
        {
            return;
        }

        var startFrame = nextFrameStart;
        var cellCount = gridWidth * gridHeight;
        var allTypes = new byte[batch.Count * cellCount];
        var allSaturation = new byte[batch.Count * cellCount];
        var plantCounts = new int[batch.Count];
        var grazerCounts = new int[batch.Count];
        var score = new int[batch.Count];
        var grazerSaturationCounts = new int[GrazerSaturationLevelCount][];

        for (var saturation = 0; saturation < GrazerSaturationLevelCount; saturation++)
        {
            grazerSaturationCounts[saturation] = new int[batch.Count];
        }

        for (var i = 0; i < batch.Count; i++)
        {
            var frame = batch[i];
            plantCounts[i] = frame.PlantCount;
            grazerCounts[i] = frame.GrazerCount;
            score[i] = frame.NormalizedScore;

            if (frame.GrazerCountsBySaturation is not null)
            {
                var saturationCount = Math.Min(frame.GrazerCountsBySaturation.Length, GrazerSaturationLevelCount);
                for (var saturation = 0; saturation < saturationCount; saturation++)
                {
                    grazerSaturationCounts[saturation][i] = frame.GrazerCountsBySaturation[saturation];
                }
            }

            var offset = i * cellCount;
            Buffer.BlockCopy(frame.Types, 0, allTypes, offset, cellCount);
            Buffer.BlockCopy(frame.Saturations, 0, allSaturation, offset, cellCount);
        }

        nextFrameStart += batch.Count;
        currentFrame = nextFrameStart - 1;

        await jsModule.InvokeVoidAsync("enqueueFrames",
            "cellCanvas", allTypes, allSaturation,
            plantCounts, grazerCounts, score, grazerSaturationCounts, startFrame);

        plantPlotHistory.AddRange(plantCounts);
        grazerPlotHistory.AddRange(grazerCounts);
        for (var saturation = 0; saturation < GrazerSaturationLevelCount; saturation++)
        {
            grazerSaturationPlotHistory[saturation].AddRange(grazerSaturationCounts[saturation]);
        }

        // Build unified plot snapshot to avoid losing batches when renders are coalesced.
        var plotRowCount = CurrentGameMode == GameMode.Mutation
            ? 2 + GrazerSaturationLevelCount
            : 2;
        var unifiedPlotBatch = new int[plotRowCount][];
        unifiedPlotBatch[0] = plantPlotHistory.ToArray();

        if (CurrentGameMode == GameMode.Simple)
        {
            unifiedPlotBatch[1] = grazerPlotHistory.ToArray();
        }
        else
        {
            for (var i = 0; i < GrazerSaturationLevelCount; i++)
            {
                unifiedPlotBatch[i + 2] = grazerSaturationPlotHistory[i].ToArray();
            }
        }

        plotBatch = unifiedPlotBatch;
        plotBatchVersion++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveResultAsync()
    {
        if (data.Count == 0)
        {
            return;
        }

        try
        {
            var lastFrame = data[^1];
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.Identity?.IsAuthenticated == true
                ? user.FindFirstValue(ClaimTypes.NameIdentifier)
                : null;

            var result = new Result
            {
                UserId = userId,
                DateTime = DateTime.UtcNow,
                Score = lastFrame.NormalizedScore,
                PlantsCreated = lastFrame.OverallPlantsCount,
                GrazersCreated = lastFrame.OverallGrazersCount
            };

            DbContext.Results.Add(result);
            await DbContext.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to persist simulation result.");
        }
    }

    [JSInvokable]
    public void OnPlaybackComplete()
    {
        playbackCompletion?.TrySetResult(true);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        try
        {
            if (jsModule is not null)
            {
                await jsModule.InvokeVoidAsync("dispose", "cellCanvas");
                await jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
