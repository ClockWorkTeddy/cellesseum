@page "/"
@rendermode InteractiveServer
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<main class="card">
    <div class="title">Cellesseum</div>

    <div class="value" id="value" style="@GetLabelStyle(visibleNumber)">
        @if (visibleNumber > 0)
        {
            @visibleNumber
        }
    </div>

    <button class="btn" id="btn" type="button" @onclick="GetNewNumbers" disabled="@isAnimating">
        @(isAnimating ? "Loading..." : "Click me")
    </button> 

    <div class="divider"></div>

    <div class="label">Average</div>
    <div class="avg" id="avg">
        @if (averageNumber > 0 && !isAnimating)
        {
            @averageNumber
        }
    </div>
</main>

@code {
    private int visibleNumber = -1;
    private int averageNumber = -1;
    private bool isAnimating;

    private async Task GetNewNumbers()
    {
        if (isAnimating)
        {
            return;
        }

        isAnimating = true;

        var result = await WeatherApi.GetWeatherAsync();
        var numbers = result?.Numbers ?? Array.Empty<int>();
        averageNumber = result?.Average ?? -1;

        foreach (var n in numbers)
        {
            visibleNumber = n;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(25);
        }

        isAnimating = false;
    }

    private string GetLabelStyle(int value)
    {
        // Normalize 0..100 -> 0..255
        var redRaw = (int)Math.Round((100 - value) / 50.0 * 255);
        var red = Math.Clamp(redRaw, 127, 255);

        // Example green channel decreasing with value, also normalized
        var greenRaw = (int)Math.Round(value / 50.0 * 255);
        var green = Math.Clamp(greenRaw, 127, 255);

        return $"--dynamic-text-color:{red},{green},128";
    }
}
